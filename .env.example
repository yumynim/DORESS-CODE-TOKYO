# =========================================================
# DRESS CODE TOKYO — 環境変数（Vercel の Project Settings → Environment Variables に設定）
# ---------------------------------------------------------
# このファイル自体はコミットしてOK（値は空のテンプレート）。
# 実際の値は絶対にこのファイルに書かず、Vercelの管理画面にだけ入力すること。
# =========================================================

# ---- Square ----
# 'sandbox' でテスト、本番稼働の直前に 'production' へ切り替える。
# 切り替えたら ACCESS_TOKEN / LOCATION_ID / WEBHOOK_SIGNATURE_KEY も本番用に全部差し替えること
# （Sandbox用とProduction用は別物。混ぜるとバグの元）。
SQUARE_ENVIRONMENT=sandbox

# Square Developer Dashboard（developer.squareup.com/apps）→ 作成したアプリ →
# Sandbox / Production それぞれの "Access Token"
SQUARE_ACCESS_TOKEN=

# Square Dashboard →「決済」→「場所（Locations）」で確認できる Location ID
SQUARE_LOCATION_ID=

# Square Developer Dashboard → Webhooks → Subscription作成時に発行される Signature Key
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Webhookの通知先URL（署名検証の計算に使う。実際にVercelへデプロイした後のURLを設定）
# 例: https://dress-code-tokyo.com/api/square-webhook
SQUARE_WEBHOOK_URL=

# ---- Supabase ----
# js/auth-config.js（ブラウザ用）と同じ Project URL / anon key。
# ここではサーバー側で「誰がログイン中か」を確認するためだけに使う（弱い権限でOK）。
SUPABASE_URL=
SUPABASE_ANON_KEY=

# こちらは強い権限（RLSを無視できる）。絶対にブラウザ側のコードに書かないこと。
# Supabase Dashboard → Project Settings → API → "service_role" キー
SUPABASE_SERVICE_ROLE_KEY=

# ---- メール通知（Resend） ----
# 決済完了／キャンセル時に購入者へ確認メールを送るほか、
# 管理者がお知らせを投稿したとき（admin-announcements.html）に会員全員へも送るために使う。
# 未設定でもエラーにはならず、メール送信だけスキップされる（サイト内通知＝マイページの「お知らせ」は届く）。
# https://resend.com でアカウント作成 → API Keys で発行
RESEND_API_KEY=

# 送信元アドレス。Resendで送信ドメインを認証してから設定すること（未認証ドメインだと送信できない）。
# 例: 'DRESS CODE TOKYO <notify@dresscode-tokyo.jp>'
NOTIFY_FROM_EMAIL=

# サイトのお問い合わせフォーム（index.html の Contact セクション → /api/contact）の転送先。
# ここに書いたアドレスに問い合わせ内容がメールで届く。Gmail等の普通のアドレスでOK
# （Resendのドメイン認証が必要なのは「送信元」であって「宛先」ではないため）。
# 未設定の場合は NOTIFY_FROM_EMAIL 宛てに届く。
CONTACT_TO_EMAIL=

# HTMLメール内のロゴ画像・CTAボタンのリンク先に使う本番URL。
# 未設定の場合は 'https://dress-code-tokyo.com' が使われる（lib/mailer.js）。
# 通常は設定不要（ドメインを変更した場合のみ上書き）。
SITE_URL=

# ---- 当日の入場確認（受付コード） ----
# 受付コードの真ん中に入るイベント識別番号（例: 2026年9月27日開催のイベントなら '0927'）。
# 発行されるコードの形: DCT-0927-N1-7K4M（末尾4文字は推測防止のランダム）。
# 「MMDD」の形を想定（同じ日に複数イベントを開催する場合のみ '0927.01' のように枝番を足す）。
# 新しいイベントを開催するたびに値を変えること
# （変えると出店者(S)・来場者(N)の連番が両方1から再スタートする。詳細は
#  supabase/schema_v10_event_sequence.sql と api/square-webhook.js のコメント参照）。
# 未設定の場合は 'EVENT' が使われる。
CURRENT_EVENT_ID=

# ---- 当日スタッフ用の合言葉（/checkin だけに入れる）----
# 当日だけ手伝ってもらうボランティアには、運営用の ADMIN_CONSOLE_PASSWORD ではなく
# こちらを渡すこと。この合言葉で入った人は入場確認しかできず、
# お客様の氏名・メールアドレス・お問い合わせ内容の閲覧や、会員全員へのメール送信はできない。
# 未設定の場合は、今まで通り ADMIN_CONSOLE_PASSWORD だけで /checkin も使える。
CHECKIN_PASSWORD=

# ---- ログイントークンの署名鍵（任意・推奨）----
# /console と /checkin のログイン状態を保持するトークンに署名するための鍵。
# 未設定でも動く（その場合は ADMIN_CONSOLE_PASSWORD から内部的に鍵を作る）が、
# 設定しておくと、万一トークンが漏れても合言葉そのものを推測される心配が無くなる。
# 適当な長いランダム文字列（例: openssl rand -hex 32 の出力）を入れておけばよい。
ADMIN_TOKEN_SECRET=

# ---- お知らせ投稿ページ（/console = admin-announcements.html）----
# チームで共有する合言葉。個人のSupabaseアカウントは不要で、この合言葉を知っている人だけが
# 会員全員へのお知らせ（サイト内通知＋メール）を投稿・削除できる。
# 十分に長く推測されにくいものにすること。漏洩したら値を変更するだけで即座に無効化できる
# （変更前に発行されたログイン状態も自動的に無効になる）。
ADMIN_CONSOLE_PASSWORD=
